# =====================================================================
# SE-EWRS environment configuration
#
# Copy this file to backend/.env and fill in real values:
#     cp .env.example backend/.env
#
# backend/.env is listed in .gitignore and must never be committed.
# Every value below is a placeholder, not a working credential.
# =====================================================================

# --- Application -----------------------------------------------------
APP_NAME="SE-EWRS API"
APP_VERSION=1.0.0
DEBUG=false

# --- Database --------------------------------------------------------
# The backend assembles a MySQL URL from these four values.
DB_HOST=localhost
DB_PORT=3306
DB_USER=se_ewrs_app
DB_PASSWORD=change-me-to-the-password-you-set-in-mysql
DB_NAME=se_ewrs

# Optional: set DATABASE_URL to override the assembled URL entirely.
# Unlike DB_PASSWORD above, which is encoded for you, a password written
# into this URL must be percent-encoded by hand (@ is %40, / is %2F).
# The test-suite sets it to SQLite; leave it unset for normal use.
#   DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/se_ewrs?charset=utf8mb4
#   DATABASE_URL=sqlite:///./dev.sqlite3
# DATABASE_URL=

# Log every SQL statement (verbose; useful when demonstrating queries).
DB_ECHO=false
DB_POOL_SIZE=10
DB_POOL_RECYCLE=1800

# TLS to a hosted MySQL: the provider's CA certificate, as the PEM text
# itself or a path to the .pem file. When set, the connection is
# encrypted and the server's certificate and host name are verified.
# Leave unset for a local server.
# DB_SSL_CA=/path/to/ca.pem

# --- Authentication --------------------------------------------------
# REQUIRED IN ANY REAL DEPLOYMENT. Generate a fresh value with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Anyone holding this key can mint a valid token for any account.
SECRET_KEY=generate-a-new-random-value-do-not-use-this-one

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Failed sign-ins allowed per window before the login endpoint answers
# 429. Counted in memory, per process: run a single uvicorn worker.
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_ADDRESS=20
LOGIN_FAILURE_WINDOW_SECONDS=900

# Reverse proxies in front of the API. 0 for a direct connection (local
# development); 1 behind one hosting proxy such as Render's, so the
# caller is the right-most X-Forwarded-For entry. Never more than the
# real number: each extra hop trusts an address the client can forge.
TRUSTED_PROXY_HOPS=0

# --- CORS ------------------------------------------------------------
# Origins allowed to call the API, comma-separated. In development the
# Vite dev server proxies /api, so this matters mainly when the frontend
# is served from a different origin than the backend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
